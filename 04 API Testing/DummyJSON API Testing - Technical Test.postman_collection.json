          "name": "07 - Add User - Positive",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "// Random First Name\r",
                  "let firstName = pm.variables.replaceIn('{{$randomFirstName}}');\r",
                  "\r",
                  "// Random Last Name\r",
                  "let lastName = pm.variables.replaceIn('{{$randomLastName}}');\r",
                  "\r",
                  "// Random Email\r",
                  "let email = `${firstName.toLowerCase()}.${lastName.toLowerCase()}@example.com`;\r",
                  "\r",
                  "// Random Age\r",
                  "let age = Math.floor(Math.random() * (60 - 20 + 1)) + 20;\r",
                  "\r",
                  "// Set Variables\r",
                  "pm.variables.set(\"FirstName\", firstName);\r",
                  "pm.variables.set(\"LastName\", lastName);\r",
                  "pm.variables.set(\"Email\", email);\r",
                  "pm.variables.set(\"Age\", age);"
                ],
                "type": "text/javascript",
                "packages": {}
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const response = pm.response.json();\r",
                  "const requestBody = JSON.parse(pm.request.body.raw);\r",
                  "\r",
                  "pm.test(\"Status code is 201\", function () {\r",
                  "    pm.response.to.have.status(201);\r",
                  "});\r",
                  "\r",
                  "pm.test(\"Response time is less than or equal to 3000 ms\", function () {\r",
                  "    pm.expect(pm.response.responseTime).to.be.at.most(3000);\r",
                  "});\r",
                  "\r",
                  "pm.test(\"Content-Type is application/json\", function () {\r",
                  "    pm.expect(pm.response.headers.get(\"Content-Type\"))\r",
                  "        .to.include(\"application/json\");\r",
                  "});\r",
                  "\r",
                  "pm.test(\"Response contains generated ID\", function () {\r",
                  "    pm.expect(response).to.have.property(\"id\");\r",
                  "});\r",
                  "\r",
                  "pm.test(\"Response data matches request payload\", function () {\r",
                  "    pm.expect(response.firstName).to.eql(requestBody.firstName);\r",
                  "    pm.expect(response.lastName).to.eql(requestBody.lastName);\r",
                  "    pm.expect(response.age).to.eql(requestBody.age);\r",
                  "    pm.expect(response.email).to.eql(requestBody.email);\r",
                  "});"
                ],
                "type": "text/javascript",
